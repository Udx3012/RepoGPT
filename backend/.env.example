# RepoGPT Backend Environment Configuration
PORT=3009

# Supabase (Database Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Google Gemini AI (Required for Embeddings and Chat)
GEMINI_API_KEY=your_gemini_api_key

# Pinecone (Optional: If omitted, embeddings are stored and searched inside Supabase repo_chunks table)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# GitHub API Token (Optional: Highly recommended to avoid rate limits on repo indexing)
GITHUB_PERSONAL_ACCESS_TOKEN=
